/*
 * 全局字号规范（所有页面/组件的文本字号必须落位，详见 scripts/align-typography.mjs 审计）：
 *   眉标 kicker 18（组件内，700 + 字距 3）/ 页面 kicker 20（type-eyebrow，600 + 字距 4）
 *   说明 meta 20 / 辅助 caption 22 / assistive 24 / 正文 body 26 / 强调 body-lg 28
 *   小标题 title-sm 30 / 标题 title 32 / 页标题 page-title 36
 *   展示字 display 44（词条/大数字）、52（大单词）/ 品牌 brand 56
 * 字重只用 400 / 600 / 700；列表箭头统一 40rpx + 300。
 */
page {
  min-height: 100%;
  background: #f4faf7;
  color: #193f36;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
  line-height: 1.5;
}

button {
  font: inherit;
  box-sizing: border-box;
}

.font-zh {
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.font-en,
.font-number {
  font-family: "Helvetica Neue", Arial, sans-serif;
}

.font-brand,
.type-brand {
  font-family: Georgia, "Times New Roman", serif;
}

.text-primary { color: #193f36; }
.text-secondary { color: #4b7066; }
.text-assistive { color: #718d85; }

.type-brand {
  color: inherit;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.2;
}

.type-page-title {
  color: #193f36;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}

.type-dialog-title {
  color: #193f36;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.35;
}

.type-nav-title,
.type-card-title {
  color: #193f36;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
}

.type-section-title {
  color: #193f36;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.type-body {
  color: #4b7066;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.5;
}

.type-assistive {
  color: #718d85;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.5;
}

.type-meta {
  color: #718d85;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.4;
}

.type-eyebrow {
  font-family: "Helvetica Neue", Arial, sans-serif;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: 4rpx;
}

.type-button {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
}

.type-stat {
  font-family: "Helvetica Neue", Arial, sans-serif;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
}

.button-base {
  min-height: 92rpx;
  margin: 0;
  padding: 20rpx 32rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
  text-align: center;
}

.button-primary {
  background: #174f45;
  color: #fff;
}

.button-secondary {
  background: #eef5f2;
  color: #4b7066;
}

button::after {
  border: 0;
}

.page-shell {
  width: 100%;
  min-height: calc(100vh + 240rpx);
  padding: 32rpx;
  box-sizing: border-box;
  overflow-x: hidden;
}

.safe-bottom {
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}

@media (max-width: 350px) {
  .page-shell {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }
}

@media (max-width: 320px) {
  .page-shell {
    padding-right: 20rpx;
    padding-left: 20rpx;
  }
}
