:host {
  display: block;
  flex: 0 0 132rpx;
  min-width: 0;
  height: 132rpx;
}

.card {
  position: relative;
  height: 100%;
  box-sizing: border-box;
  border: 3rpx solid transparent;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 16rpx;
  transition: transform 220ms ease, opacity 320ms ease, filter 360ms ease, background 220ms ease, border-color 220ms ease;
  will-change: transform, opacity, filter;
}

.card--filled {
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(31, 91, 76, 0.08);
}

.card--empty {
  border: 2rpx dashed rgba(83, 139, 126, 0.16);
  background: rgba(255, 255, 255, 0.22);
  box-shadow: none;
}

.card--pressed {
  transform: scale(0.97);
}

.card--selected {
  border-color: #4aa7c4;
  background: #eaf7fb;
  box-shadow: 0 10rpx 24rpx rgba(36, 129, 158, 0.16);
}

.card--correct {
  border-color: #30ad75;
  background: #e8f8ef;
  animation: correct-soften 600ms cubic-bezier(.22, 1, .36, 1) both;
}

.card--wrong {
  border-color: #e45c5c;
  background: #fff0ef;
  animation: wrong-shake 320ms ease both;
}

.card--waiting {
  border-color: rgba(48, 173, 117, .62);
  background: #e8f8ef;
  filter: blur(2.5rpx);
  opacity: .62;
  transform: scale(.99);
  pointer-events: none;
}

.card--removing {
  border-color: #30ad75;
  background: #e8f8ef;
  animation: card-away 440ms cubic-bezier(.4, 0, .2, 1) both;
  pointer-events: none;
}

.card--entering {
  animation: card-enter 460ms cubic-bezier(.16, 1, .3, 1) both;
  pointer-events: none;
}

.card__english {
  display: block;
  max-width: 100%;
  color: #193f36;
  font-family: "Helvetica Neue", Arial, sans-serif;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
}

.card__english--long { font-size: 32rpx; }
.card__english--xlong { font-size: 28rpx; }

.card__chinese {
  display: block;
  max-width: 100%;
  color: #193f36;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
  text-align: center;
  white-space: normal;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.card__chinese--long {
  font-size: 28rpx;
  line-height: 1.32;
}

.card__chinese--xlong {
  font-size: 24rpx;
  line-height: 1.28;
}

.card__meta {
  margin-top: 8rpx;
  color: #718d85;
  font-family: "Helvetica Neue", Arial, sans-serif;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.3;
}

.card__placeholder {
  width: 24rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: rgba(83, 139, 126, 0.12);
}

@keyframes correct-soften {
  0% { filter: blur(0); opacity: 1; transform: scale(1); }
  42% { filter: blur(0); opacity: 1; transform: scale(1.035); }
  100% { filter: blur(2.5rpx); opacity: .72; transform: scale(.99); }
}

@keyframes wrong-shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-8rpx); }
  50% { transform: translateX(8rpx); }
  75% { transform: translateX(-4rpx); }
}

@keyframes card-away {
  from { filter: blur(2.5rpx); opacity: .72; transform: scale(.99); }
  to { filter: blur(12rpx); opacity: 0; transform: scale(.94) translateY(-4rpx); }
}

@keyframes card-enter {
  from { filter: blur(9rpx); opacity: 0; transform: translateY(12rpx) scale(.97); }
  65% { filter: blur(0); opacity: 1; }
  to { filter: blur(0); opacity: 1; transform: translateY(0) scale(1); }
}

@media (max-height: 650px) {
  :host {
    flex-basis: 116rpx;
    height: 116rpx;
  }

  .card {
    padding: 10rpx 14rpx;
  }
}

@media (min-height: 651px) and (max-height: 700px) {
  :host {
    flex-basis: 124rpx;
    height: 124rpx;
  }
}
