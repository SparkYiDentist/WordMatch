.vocabulary-page { min-height: calc(100vh + 240rpx); }
.vocab-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; padding: 18rpx 4rpx 34rpx; }
.vocab-head__copy { flex: 1; min-width: 0; }
.vocab-head__kicker, .vocab-head__title, .vocab-head__summary { display: block; }
.vocab-head__kicker { color: #2c8772; }
.vocab-head__title { margin-top: 12rpx; color: #193f36; }
.vocab-head__summary { margin-top: 12rpx; color: #4b7066; }
.vocab-head__count { flex-shrink: 0; width: 82rpx; height: 82rpx; border-radius: 26rpx; display: flex; align-items: center; justify-content: center; font-family: "Helvetica Neue", Arial, sans-serif; font-size: 36rpx; font-weight: 700; }
.vocab-head__count--today { background: #def4ec; color: #217861; }
.vocab-head__count--learned { background: #e2f0f6; color: #327992; }
.vocab-head__count--wrong { background: #fff0ee; color: #d9655a; }
.word-list { display: flex; flex-direction: column; gap: 14rpx; }
.manage-date-list { display: flex; flex-direction: column; gap: 16rpx; }
.manage-date { overflow: hidden; border: 2rpx solid #eadfdb; border-radius: 26rpx; background: #fffaf8; box-shadow: 0 8rpx 24rpx rgba(98,55,47,.05); }
.manage-date__head { min-height: 102rpx; padding: 18rpx 24rpx; display: flex; align-items: center; justify-content: space-between; transition: opacity 120ms ease, background 120ms ease; }
.manage-date__head--pressed { opacity: .78; background: #fff3ef; }
.manage-date__calendar { min-width: 0; }
.manage-date__day, .manage-date__full { display: block; }
.manage-date__day { color: #633a33; font-size: 30rpx; font-weight: 700; }
.manage-date__full { margin-top: 3rpx; color: #9a756d; font-family: "Helvetica Neue", Arial, sans-serif; font-size: 20rpx; }
.manage-date__meta { display: flex; align-items: center; gap: 14rpx; color: #946d66; font-size: 24rpx; font-weight: 600; }
.manage-date__delete { flex-shrink: 0; width: 116rpx; min-height: 44rpx; margin: 0; padding: 4rpx 8rpx; border: 1rpx solid #f3d8d2; border-radius: 999rpx; background: #fff7f5; color: #ad625a; display: flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 600; line-height: 1.2; }
.manage-date__arrow { font-size: 40rpx; font-weight: 300; line-height: 1; transform: rotate(0); transition: transform 180ms ease; }
.manage-date__arrow--open { transform: rotate(90deg); }
.manage-date__body { padding: 0 14rpx 14rpx; }
.manage-date__scroll { overflow: hidden; }
.word-row { padding: 24rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(31,91,76,.06); display: flex; align-items: center; gap: 20rpx; }
.word-row--nested { height: 140rpx; margin-top: 8rpx; padding: 16rpx 18rpx; box-sizing: border-box; border: 2rpx solid #f3e8e4; border-radius: 20rpx; box-shadow: none; gap: 12rpx; }
.word-row--nested .word-row__heading { flex-wrap: nowrap; }
.word-row--nested .word-row__english { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.word-row--nested .word-row__chinese { overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; }
.word-row__main { flex: 1; min-width: 0; }
.word-row__heading { display: flex; align-items: baseline; flex-wrap: wrap; gap: 6rpx 12rpx; min-width: 0; }
.word-row__english { max-width: 100%; color: #193f36; font-family: "Helvetica Neue", Arial, sans-serif; font-size: 30rpx; font-weight: 600; line-height: 1.2; overflow-wrap: anywhere; }
.word-row__pos { color: #718d85; font-family: "Helvetica Neue", Arial, sans-serif; font-size: 22rpx; font-style: normal; line-height: 1.3; }
.word-row__chinese { display: block; margin-top: 7rpx; color: #4b7066; font-size: 24rpx; line-height: 1.45; }
.word-row__meta { flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; }
.word-row__tag { color: #4b7066; font-size: 22rpx; font-weight: 600; }
.word-row__date { margin-top: 6rpx; color: #718d85; font-family: "Helvetica Neue", Arial, sans-serif; font-size: 20rpx; line-height: 1.3; }
.review-button { position: sticky; bottom: 26rpx; width: 100%; margin-top: 28rpx; }
.empty-state { margin-top: 90rpx; text-align: center; }
.empty-state__mark { width: 108rpx; height: 108rpx; margin: 0 auto; border-radius: 36rpx; background: #dff5ed; color: #23906f; display: flex; align-items: center; justify-content: center; font-size: 50rpx; }
.empty-state__title { margin-top: 30rpx; }
.empty-state__desc { margin: 14rpx auto 30rpx; max-width: 520rpx; color: #4b7066; }
.empty-state button { width: 360rpx; max-width: 100%; margin-right: auto; margin-left: auto; }

@media (max-width: 350px) {
  .word-row { align-items: flex-start; padding-right: 20rpx; padding-left: 20rpx; gap: 12rpx; }
  .word-row__meta { max-width: 150rpx; }
}
