.levels-page { min-height: calc(100vh + 240rpx); }
.page-intro { margin: 12rpx 0 40rpx; padding: 36rpx; border-radius: 34rpx; background: #194f46; color: #fff; }
.page-intro__kicker, .page-intro__title, .page-intro__desc { display: block; }
.page-intro__kicker { color: #fff; }
.page-intro__title { margin-top: 18rpx; color: #fff; }
.page-intro__desc { margin-top: 12rpx; color: #fff; }
.level-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 40rpx; row-gap: 30rpx; padding-bottom: 24rpx; }
.level-card { width: 100%; min-height: 248rpx; margin: 0; padding: 28rpx; box-sizing: border-box; border: 1rpx solid rgba(31, 91, 76, .05); border-radius: 30rpx; background: #fff; box-shadow: 0 12rpx 30rpx rgba(31, 91, 76, .07); color: #193f36; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; line-height: 1.25; text-align: left; }
.level-card__number { width: 68rpx; height: 68rpx; flex: none; border-radius: 22rpx; background: #dff5ed; display: flex; align-items: center; justify-content: center; color: #216b5d; }
.level-card__label { margin-top: 20rpx; }
.level-card__stars { margin-top: 12rpx; color: #dce6e2; font-size: 26rpx; line-height: 1.2; letter-spacing: 4rpx; }
.level-card__locked-text { margin-top: 12rpx; color: #718d85; }
.star--on { color: #edb84e; }
.level-card--locked { border-color: rgba(75, 112, 102, .08); background: #f0f5f3; box-shadow: none; color: #4b7066; }
.level-card--locked .level-card__number { background: #e3eae7; color: #718d85; }
