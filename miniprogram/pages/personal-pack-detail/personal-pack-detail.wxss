.detail-page { min-height: calc(100vh + 240rpx); background: #f4faf7; }
.detail-hero { padding: 34rpx 30rpx; border-radius: 32rpx; background: #174f45; color: #fff; box-shadow: 0 14rpx 30rpx rgba(23,79,69,.16); }
.detail-hero__kicker, .detail-hero__title { display: block; }
.detail-hero__kicker { color: #8fe0c3; }
.detail-hero__title { margin-top: 14rpx; overflow-wrap: anywhere; font-size: 44rpx; font-weight: 700; line-height: 1.3; }
.detail-hero__meta { margin-top: 16rpx; color: rgba(255,255,255,.72); display: flex; flex-wrap: wrap; gap: 8rpx 24rpx; font-size: 22rpx; }
.hero-progress { margin-top: 30rpx; }
.hero-progress__copy { display: flex; justify-content: space-between; color: rgba(255,255,255,.82); font-size: 22rpx; }
.hero-progress__track { height: 10rpx; margin-top: 10rpx; border-radius: 999rpx; background: rgba(255,255,255,.16); overflow: hidden; }
.hero-progress__bar { height: 100%; border-radius: inherit; background: #91e1c4; }
.stats-grid { margin-top: 18rpx; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.stat { min-width: 0; padding: 20rpx 8rpx; border-radius: 22rpx; background: #fff; text-align: center; }
.stat__value, .stat__label { display: block; }
.stat__value { color: #193f36; font-family: "Helvetica Neue", sans-serif; font-size: 30rpx; font-weight: 700; }
.stat__label { margin-top: 4rpx; color: #718d85; font-size: 20rpx; }
.test-panel, .manage-panel { margin-top: 18rpx; padding: 26rpx; border-radius: 28rpx; background: #fff; }
.panel-title { display: block; color: #193f36; font-size: 30rpx; font-weight: 700; }
.panel-label { display: block; margin: 22rpx 0 12rpx; color: #4b7066; font-size: 24rpx; font-weight: 600; }
.panel-label--spaced { margin-top: 26rpx; }
.segmented { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; }
.segment, .count { min-width: 0; min-height: 72rpx; padding: 12rpx 6rpx; border: 2rpx solid #e5efeb; border-radius: 17rpx; color: #58796f; display: flex; align-items: center; justify-content: center; text-align: center; font-size: 24rpx; box-sizing: border-box; }
.segment--active, .count--active { border-color: #43aa89; background: #e6f7f0; color: #176b57; font-weight: 700; }
.count-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10rpx; }
.availability { margin: 22rpx 0 14rpx; color: #2b7663; font-size: 24rpx; text-align: center; }
.availability--warn { color: #b06056; }
.button-primary[disabled] { background: #8ba099; color: #fff; }
.manage-panel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12rpx; }
.manage-panel button { display: flex; align-items: center; justify-content: center; text-align: center; min-width: 0; min-height: 72rpx; margin: 0; padding: 12rpx; border-radius: 18rpx; background: #eff6f3; color: #426b60; font-size: 24rpx; line-height: 1.3; overflow-wrap: anywhere; }
.manage-panel .danger { background: #fff0ee; color: #ac514b; }
