page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}
.log-item {
  margin-top: 20rpx;
  color: #4b7066;
  font-family: "Helvetica Neue", Arial, sans-serif;
  font-size: 24rpx;
  line-height: 1.4;
  text-align: center;
}
.log-item:last-child {
  padding-bottom: env(safe-area-inset-bottom);
}
