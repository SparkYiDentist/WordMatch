<view class="settings-page">
  <view class="page-shell safe-bottom settings-shell">
    <view class="settings-head">
      <text class="type-eyebrow settings-head__eyebrow">WORDMATCH SETTINGS</text>
      <text class="type-page-title settings-head__title">设置</text>
      <text class="type-body settings-head__desc">管理本地数据与使用偏好</text>
    </view>

    <view class="settings-group">
      <text class="type-meta settings-group__label">学习记录</text>
      <view class="settings-item" hover-class="settings-item--pressed" bindtap="openWrongManager">
        <view class="settings-item__icon settings-item__icon--wrong">!</view>
        <view class="settings-item__copy">
          <text class="type-card-title">错题条目管理</text>
          <text class="type-assistive">按日期查看并删除整天错题</text>
        </view>
        <text class="settings-item__arrow">›</text>
      </view>
    </view>

    <view class="settings-group">
      <text class="type-meta settings-group__label">数据与存储</text>
      <view class="settings-item" hover-class="settings-item--pressed" bindtap="openStorageManager">
        <view class="settings-item__icon">⌁</view>
        <view class="settings-item__copy">
          <text class="type-card-title">存储空间管理</text>
          <text class="type-assistive">查看占用并安全清理缓存</text>
        </view>
        <text class="settings-item__arrow">›</text>
      </view>
    </view>
  </view>
</view>
<global-dictionary id="globalDictionary" />
