.quiz-page { min-height: calc(100vh + 240rpx); background: #f4f8f6; color: #193f36; }
.quiz-top { flex-shrink: 0; min-height: 82rpx; padding: 0 28rpx; display: grid; grid-template-columns: 158rpx minmax(0, 1fr) 158rpx; align-items: center; column-gap: 8rpx; box-sizing: border-box; }
.quiz-top__side { display: flex; align-items: center; justify-content: flex-start; }
.quiz-top__side--end { justify-content: flex-end; }
.quiz-top__center { min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; pointer-events: none; }
.quiz-top__mode { width: 100%; overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.quiz-top__mode-sub { margin-top: 4rpx; color: #759087; font-family: "Helvetica Neue", Arial, sans-serif; font-size: 18rpx; font-weight: 700; letter-spacing: 3rpx; white-space: nowrap; }
.back-button, .pause-button { min-height: 72rpx; margin: 0; padding: 8rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; background: transparent; color: #193f36; line-height: 1.2; }
.back-button { width: 72rpx; font-family: "Helvetica Neue", Arial, sans-serif; font-size: 56rpx; font-weight: 300; }
.pause-button { width: 88rpx; font-size: 24rpx; font-weight: 600; }
.quiz-status { height: 58rpx; padding: 0 32rpx; border-top: 2rpx solid #e7efec; border-bottom: 2rpx solid #e7efec; display: flex; align-items: center; color: #66837b; font-size: 22rpx; }
.status-dot { width: 5rpx; height: 5rpx; margin: 0 14rpx; border-radius: 50%; background: #91aaa3; }.status-spacer { flex: 1; }
.quiz-scroll { width: 100%; min-height: calc(100vh - 240rpx); box-sizing: border-box; }
.quiz-content { width: 100vw; max-width: 100%; box-sizing: border-box; margin: 0; padding: 30rpx 24rpx 0; }
.word-card { min-height: 236rpx; padding: 38rpx 28rpx; border: 2rpx solid #e4eee9; border-radius: 32rpx; background: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 12rpx 34rpx rgba(31,91,76,.07); transition: border-color 180ms ease, transform 180ms ease; }
.word-card--success { border-color: #9ed8c6; transform: translateY(-2rpx); }
.word-card__eyebrow { color: #80a198; font-size: 18rpx; font-weight: 700; letter-spacing: 3rpx; }
.word-card__headword-row { max-width: 100%; margin-top: 18rpx; display: flex; align-items: center; justify-content: center; gap: 14rpx; }
.word-card__word { min-width: 0; color: #173f36; font-family: "Helvetica Neue", Arial, sans-serif; font-size: 52rpx; font-weight: 600; line-height: 1.2; text-align: center; overflow-wrap: anywhere; }
.pronunciation-button { flex: 0 0 auto; min-width: 92rpx; min-height: 58rpx; margin: 0; padding: 8rpx 16rpx; border-radius: 999rpx; background: #e3f0eb; color: #2c6c5d; font-size: 22rpx; font-weight: 600; line-height: 1.4; }
.word-card__meta { margin-top: 14rpx; display: flex; align-items: center; gap: 14rpx; color: #718d85; font-size: 24rpx; }.pos-pill { padding: 3rpx 12rpx; border-radius: 999rpx; background: #eaf5f0; color: #367b69; font-size: 20rpx; }
.question-hint { display: block; margin: 30rpx 4rpx 16rpx; color: #496d63; font-size: 26rpx; }
.option-list { width: 100%; max-width: none; align-self: stretch; display: flex; flex-direction: column; gap: 16rpx; }
.quiz-option { position: relative; box-sizing: border-box; width: 100%; max-width: none; min-height: 100rpx; margin: 0; padding: 20rpx 22rpx; border: 2rpx solid #dfe9e5; border-radius: 24rpx; background: #fff; color: #244c42; display: flex; align-items: center; justify-content: center; line-height: 1.42; text-align: center; transition: transform 120ms ease, background 160ms ease, border-color 160ms ease; }
.quiz-option--disabled { opacity: 1; }.quiz-option--pressed { transform: scale(.985); }.quiz-option__label { position: absolute; top: 50%; left: 22rpx; width: 54rpx; height: 54rpx; border-radius: 18rpx; background: #edf4f1; display: flex; align-items: center; justify-content: center; font-family: "Helvetica Neue", Arial, sans-serif; font-size: 24rpx; font-weight: 700; transform: translateY(-50%); }
.quiz-option__meaning { width: 100%; min-width: 0; box-sizing: border-box; padding: 0 70rpx; font-size: 30rpx; font-weight: 600; text-align: center; white-space: normal; overflow-wrap: anywhere; }.quiz-option__mark { position: absolute; top: 50%; right: 24rpx; font-size: 34rpx; font-weight: 700; transform: translateY(-50%); }
.quiz-option--wrong { border-color: #efb8af; background: #fff0ed; color: #9f4e47; }.quiz-option--wrong .quiz-option__label { background: #f8d8d3; }.quiz-option--correct { border-color: #65b99e; background: #e2f5ed; color: #14614f; animation: correct-pop 220ms ease-out; }.quiz-option--correct .quiz-option__label { background: #bde5d5; }
@keyframes correct-pop { 0% { transform: scale(.985); } 65% { transform: scale(1.012); } 100% { transform: scale(1); } }
.feedback { margin-top: 14rpx; padding: 16rpx 20rpx; border-radius: 18rpx; font-size: 24rpx; }.feedback--wrong { background: #fff3f0; color: #a05850; }
.explanation { margin-top: 26rpx; padding: 28rpx 24rpx; border-radius: 30rpx; background: #fff; box-shadow: 0 12rpx 34rpx rgba(31,91,76,.07); animation: reveal 240ms ease-out; }
@keyframes reveal { from { opacity: 0; transform: translateY(14rpx); } to { opacity: 1; transform: translateY(0); } }
.explanation__head { display: flex; align-items: center; justify-content: space-between; }.explanation__eyebrow,.explanation__title { display: block; }.explanation__eyebrow { color: #78a095; font-size: 18rpx; font-weight: 700; letter-spacing: 3rpx; }.explanation__title { margin-top: 5rpx; font-size: 30rpx; font-weight: 600; }.learned-badge { padding: 8rpx 14rpx; border-radius: 999rpx; background: #e1f4ec; color: #24715e; font-size: 22rpx; font-weight: 600; }
.entry-lead { padding: 28rpx 0 20rpx; border-bottom: 2rpx solid #edf2f0; }.entry-lead__word { display: block; font-family: Georgia, "Times New Roman", serif; font-size: 44rpx; font-weight: 700; }.phonetics { margin-top: 6rpx; display: flex; flex-wrap: wrap; gap: 16rpx; color: #718d85; font-size: 24rpx; }
.detail-block { margin-top: 18rpx; padding: 20rpx; border-radius: 20rpx; background: #f7faf9; color: #3d6057; font-size: 26rpx; }.detail-block--primary { background: #ecf6f2; }.detail-label { display: block; margin-bottom: 10rpx; color: #6d8981; font-size: 22rpx; font-weight: 700; letter-spacing: 1rpx; }.sense { display: flex; gap: 14rpx; }.sense + .sense { margin-top: 16rpx; }.sense__pos { width: 62rpx; flex-shrink: 0; color: #287662; font-family: Georgia, serif; font-size: 22rpx; font-weight: 700; }.sense__copy,.sense__meaning,.sense__full { display: block; }.sense__copy { flex: 1; min-width: 0; }.sense__meaning { font-size: 28rpx; font-weight: 600; }.sense__full { margin-top: 5rpx; color: #5e7b73; font-size: 24rpx; }
.english-definition { font-family: Georgia, "Times New Roman", serif; font-size: 26rpx; line-height: 1.6; }.example + .example { margin-top: 16rpx; }.example__en,.example__zh { display: block; }.example__en { font-family: Georgia, "Times New Roman", serif; font-size: 26rpx; line-height: 1.55; }.example__zh { margin-top: 5rpx; color: #718d85; font-size: 24rpx; }.chip-row { display: flex; flex-wrap: wrap; gap: 9rpx; }.info-chip,.book-tag { padding: 7rpx 12rpx; border-radius: 999rpx; background: #e5f2ed; color: #347463; font-size: 22rpx; }.word-list + .word-list { margin-top: 16rpx; }.forms { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 10rpx; }.form-row { padding: 10rpx; border-radius: 12rpx; background: #fff; }.form-row text { display: block; }.form-row text:first-child { color: #7b948d; font-size: 20rpx; }.form-row text:last-child { margin-top: 2rpx; font-size: 24rpx; font-weight: 600; }.etymology { display: block; margin-top: 10rpx; }.book-row { margin-top: 20rpx; display: flex; align-items: center; flex-wrap: wrap; gap: 9rpx; }.book-row .detail-label { width: 100%; margin-bottom: 2rpx; }
.detail-actions { margin-top: 22rpx; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12rpx; }.detail-action { min-width: 0; min-height: 74rpx; margin: 0; padding: 12rpx; border-radius: 18rpx; background: #eef5f2; color: #2a6d5c; font-size: 24rpx; font-weight: 600; line-height: 1.3; display: flex; align-items: center; justify-content: center; text-align: center; overflow-wrap: anywhere; }.scroll-safe { height: 190rpx; }
.next-dock { position: fixed; right: 0; bottom: 0; left: 0; z-index: 6; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); background: linear-gradient(to bottom, rgba(244,248,246,0), #f4f8f6 24%); }.next-button { width: 100%; min-height: 94rpx; margin: 0; border-radius: 25rpx; background: #174f45; color: #fff; font-size: 30rpx; font-weight: 600; box-shadow: 0 12rpx 28rpx rgba(23,79,69,.2); }.next-button text { margin-left: 10rpx; }
.pause-backdrop { position: fixed; inset: 0; z-index: 20; background: rgba(19,48,41,.42); display: flex; align-items: flex-end; }.pause-sheet { width: 100%; padding: 16rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 36rpx 36rpx 0 0; background: #fff; text-align: center; }.pause-sheet__handle { width: 72rpx; height: 8rpx; margin: 0 auto 26rpx; border-radius: 999rpx; background: #d8e4e0; }.pause-sheet__kicker,.pause-sheet__title,.pause-sheet__desc { display: block; }.pause-sheet__kicker { color: #56a28d; font-size: 18rpx; font-weight: 700; letter-spacing: 3rpx; }.pause-sheet__title { margin-top: 12rpx; font-size: 36rpx; font-weight: 700; }.pause-sheet__desc { margin: 12rpx auto 28rpx; color: #6b8880; font-size: 24rpx; }.pause-primary,.pause-secondary { width: 100%; min-height: 88rpx; margin: 12rpx 0 0; border-radius: 23rpx; font-size: 28rpx; font-weight: 600; }.pause-primary { background: #174f45; color: #fff; }.pause-secondary { background: #eef5f2; color: #496d63; }
.result-view { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }.result-mark { width: 220rpx; height: 220rpx; border: 18rpx solid #c8eadd; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; color: #174f45; font-family: "Helvetica Neue", Arial, sans-serif; font-size: 64rpx; font-weight: 700; box-shadow: 0 12rpx 32rpx rgba(31,91,76,.08); }.result-mark text { margin-top: 20rpx; font-size: 24rpx; }.result-kicker,.result-title { display: block; }.result-kicker { margin-top: 34rpx; color: #6e958a; font-size: 18rpx; font-weight: 700; letter-spacing: 3rpx; }.result-title { margin-top: 10rpx; font-size: 36rpx; font-weight: 700; }.result-grid { width: 100%; margin: 34rpx 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12rpx; }.result-grid view { padding: 22rpx; border-radius: 22rpx; background: #fff; }.result-grid text { display: block; }.result-grid text:first-child { color: #174f45; font-size: 36rpx; font-weight: 700; }.result-grid text:last-child { margin-top: 5rpx; color: #718d85; font-size: 22rpx; }.result-primary,.result-secondary { width: 100%; min-height: 92rpx; margin: 12rpx 0 0; border-radius: 24rpx; font-size: 28rpx; font-weight: 600; }.result-primary { background: #174f45; color: #fff; }.result-secondary { background: #e7f0ed; color: #42675d; }
@media (max-width: 350px) { .quiz-content { padding-right: 18rpx; padding-left: 18rpx; }.word-card { min-height: 208rpx; }.word-card__word { font-size: 44rpx; }.quiz-option__meaning { font-size: 28rpx; }.detail-actions { grid-template-columns: 1fr; } }
