.storage-page { min-height: calc(100vh + 240rpx); background: #f4faf7; }
.storage-shell { padding: 42rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); }
.storage-head { padding: 10rpx 8rpx 28rpx; }
.storage-head text { display: block; }
.storage-head .type-body { margin-top: 8rpx; }
.state-card { min-height: 300rpx; border-radius: 28rpx; background: #fff; color: #4b7066; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 8rpx 28rpx rgba(31,91,76,.05); }
.loading-ring { width: 46rpx; height: 46rpx; margin-bottom: 20rpx; border: 6rpx solid #dceee7; border-top-color: #2b806e; border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.usage-card { padding: 30rpx; border-radius: 30rpx; background: linear-gradient(145deg, #174f45, #2d806e); color: #fff; box-shadow: 0 12rpx 32rpx rgba(31,91,76,.16); }
.usage-card__top { display: flex; align-items: flex-end; justify-content: space-between; gap: 18rpx; }
.usage-card__label, .usage-card__value { display: block; color: #fff; }
.usage-card__label { opacity: .72; }
.usage-card__value { margin-top: 8rpx; font-family: "Helvetica Neue", Arial, sans-serif; font-size: 52rpx; font-weight: 700; line-height: 1.1; }
.usage-card__limit { padding-bottom: 5rpx; color: rgba(255,255,255,.8); font-size: 22rpx; }
.progress-track { height: 12rpx; margin-top: 26rpx; border-radius: 999rpx; overflow: hidden; background: rgba(255,255,255,.16); }
.progress-fill { height: 100%; min-width: 2rpx; border-radius: inherit; background: #9ce2c7; transition: width 240ms ease; }
.progress-copy { margin-top: 9rpx; display: flex; justify-content: space-between; color: rgba(255,255,255,.7); font-size: 20rpx; }
.metric-grid { margin-top: 26rpx; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; }
.metric { min-width: 0; padding: 18rpx 8rpx; border-radius: 18rpx; background: rgba(255,255,255,.1); text-align: center; }
.metric text { display: block; overflow-wrap: anywhere; }
.metric text:first-child { font-family: "Helvetica Neue", Arial, sans-serif; font-size: 26rpx; font-weight: 700; }
.metric text:last-child { margin-top: 4rpx; color: rgba(255,255,255,.7); font-size: 20rpx; }
.usage-card__time { display: block; margin-top: 20rpx; color: rgba(255,255,255,.62); font-size: 20rpx; text-align: right; }
.section-block { margin-top: 32rpx; }
.section-heading { margin: 0 8rpx 14rpx; display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.detail-card, .cleanup-list { overflow: hidden; border: 2rpx solid #e6efeb; border-radius: 26rpx; background: #fff; box-shadow: 0 7rpx 24rpx rgba(31,91,76,.045); }
.detail-row, .cleanup-row { min-height: 112rpx; padding: 20rpx 22rpx; box-sizing: border-box; display: flex; align-items: center; }
.detail-row + .detail-row, .cleanup-row + .cleanup-row { border-top: 2rpx solid #edf3f0; }
.detail-row__mark { width: 12rpx; height: 44rpx; flex-shrink: 0; border-radius: 999rpx; background: #b9ccc5; }
.detail-row__mark--important { background: #2c9274; }
.detail-row__mark--cache { background: #dfaa55; }
.detail-row__mark--bundled { background: #6a9db3; }
.detail-row__copy, .cleanup-row__copy { flex: 1; min-width: 0; margin: 0 18rpx; }
.detail-row__copy text, .cleanup-row__copy text, .cleanup-row__action text, .offline-card text { display: block; }
.detail-row__copy text:first-child, .cleanup-row__copy text:first-child, .offline-card view > text:first-child { color: #193f36; font-size: 26rpx; font-weight: 600; }
.detail-row__copy text:last-child, .cleanup-row__copy text:last-child, .offline-card view > text:last-child { margin-top: 4rpx; color: #718d85; font-size: 20rpx; line-height: 1.4; }
.detail-row__size { flex-shrink: 0; color: #315f53; font-family: "Helvetica Neue", Arial, sans-serif; font-size: 22rpx; font-weight: 600; }
.cleanup-row { transition: background 120ms ease, opacity 120ms ease; }
.cleanup-row:active { background: #f0f8f4; }
.cleanup-row--disabled { opacity: .55; }
.cleanup-row__copy { margin-left: 0; }
.cleanup-row__action { flex-shrink: 0; margin-left: 14rpx; text-align: right; }
.cleanup-row__action text:first-child { color: #315f53; font-family: "Helvetica Neue", Arial, sans-serif; font-size: 22rpx; }
.cleanup-row__action text:last-child { margin-top: 4rpx; color: #2c8772; font-size: 22rpx; font-weight: 600; }
.clear-all, .refresh-button { width: 100%; min-height: 88rpx; margin: 18rpx 0 0; border-radius: 22rpx; font-size: 28rpx; font-weight: 600; line-height: 1.3; }
.clear-all { background: #176b57; color: #fff; }
.clear-all[disabled] { background: #dbe8e3; color: #78948c; }
.refresh-button { background: #e4f2ec; color: #176b57; }
.offline-card { min-height: 112rpx; padding: 20rpx 22rpx; border: 2rpx solid #e6efeb; border-radius: 26rpx; background: #fff; display: flex; align-items: center; }
.offline-card__icon { width: 62rpx; height: 62rpx; flex-shrink: 0; border-radius: 18rpx 8rpx 18rpx 8rpx; background: #e4f3ed; color: #21725e; display: flex; align-items: center; justify-content: center; font-family: Georgia, serif; font-size: 25rpx; font-weight: 700; }
.offline-card view { flex: 1; min-width: 0; margin-left: 18rpx; }
.offline-card__tag { flex-shrink: 0; margin-left: 10rpx; padding: 6rpx 12rpx; border-radius: 999rpx; background: #edf3f0; color: #718d85; font-size: 20rpx; }
.notice { margin-top: 24rpx; padding: 20rpx 22rpx; border-radius: 20rpx; background: #e9f4ef; color: #4b7066; font-size: 22rpx; line-height: 1.55; }
.notice text { display: block; }
.notice text + text { margin-top: 8rpx; }
.notice--warning { margin: 0 0 18rpx; background: #fff3dc; color: #8a6728; }
@media (max-width: 350px) {
  .metric-grid { grid-template-columns: 1fr; }
  .metric { display: flex; justify-content: space-between; text-align: left; }
  .metric text:last-child { margin-top: 0; }
  .detail-row, .cleanup-row { padding-right: 18rpx; padding-left: 18rpx; }
}
