.home {
  min-height: calc(100vh + 240rpx);
  background: #f6f9f7;
}

.home-shell {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding-right: 24rpx;
  padding-left: 24rpx;
  padding-top: 0;
}

.daily-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 0;
}

.daily-bar__copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.daily-bar__hello {
  color: #193f36;
}

.daily-bar__streak {
  margin-top: 8rpx;
  color: #4b7066;
}

.check-in {
  flex-shrink: 0;
  width: auto;
  min-height: 68rpx;
  margin: 0;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #1f7666;
  color: #ffffff;
  line-height: 1.3;
  box-shadow: 0 6rpx 18rpx rgba(31, 118, 102, .12);
}

.check-in--done {
  background: #dcebe6;
  color: #52766d;
  box-shadow: none;
}

.check-in__icon {
  font-size: 28rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  width: calc(100% + 48rpx);
  margin-left: -24rpx;
  padding: 180rpx 24rpx 32rpx;
  box-sizing: border-box;
  background: linear-gradient(140deg, #174f45 0%, #2b806e 100%);
  color: #ffffff;
}

.hero::after {
  content: '';
  position: absolute;
  right: -80rpx;
  top: -100rpx;
  width: 260rpx;
  height: 260rpx;
  border: 38rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 50%;
}

.hero__eyebrow { color: #fff; }
.hero__title-row { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.hero__title { color: #fff; letter-spacing: -1rpx; }
.hero__subtitle { margin-top: 8rpx; color: #fff; font-weight: 600; }
.mode-section { display: flex; flex-direction: column; gap: 16rpx; }
.play-switch { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 8rpx; padding: 8rpx; border-radius: 22rpx; background: #e7efec; }
.play-switch__item { min-height: 82rpx; border: 2rpx solid transparent; border-radius: 17rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #66837b; transition: background 140ms ease, transform 140ms ease; }
.play-switch__item--active { border-color: #cfe4dc; background: #fff; color: #174f45; box-shadow: 0 4rpx 14rpx rgba(31,91,76,.08); }
.play-switch__name { font-size: 28rpx; font-weight: 600; }
.play-switch__en { margin-top: 2rpx; font-family: "Helvetica Neue", Arial, sans-serif; font-size: 18rpx; font-weight: 700; letter-spacing: 3rpx; opacity: .7; }
.section-title { color: #193f36; }
.mode-list { width: 100%; display: flex; flex-direction: column; gap: 24rpx; }
.mode-card { width: 100%; min-height: 132rpx; padding: 22rpx 24rpx; box-sizing: border-box; border-radius: 24rpx; display: flex; align-items: center; color: #193f36; text-align: left; transition: transform 120ms ease, opacity 120ms ease; box-shadow: 0 6rpx 18rpx rgba(31, 91, 76, .04); }
.mode-card--pressed { opacity: .82; transform: scale(.985); }
.mode-card--mint { background: #dff5ed; }
.mode-card--blue { background: #e3f1f7; }
.mode-card--sand { background: #f6eddc; }
.mode-card__icon { flex-shrink: 0; width: 76rpx; height: 76rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,.76); color: #216b5d; font-size: 42rpx; font-weight: 600; }
.mode-card__copy { flex: 1; min-width: 0; margin-left: 24rpx; }
.mode-card__title { color: #193f36; }
.mode-card__desc { margin-top: 6rpx; color: #4b7066; }
.mode-card__arrow { color: #4b7066; font-family: "Helvetica Neue", Arial, sans-serif; font-size: 40rpx; font-weight: 300; }

.learning-footer { display: flex; flex-direction: column; gap: 16rpx; }
.section-label { margin: 0; color: #193f36; }
.stats-card { min-height: 140rpx; box-sizing: border-box; display: flex; align-items: stretch; padding: 12rpx; border-radius: 24rpx; background: #ffffff; box-shadow: 0 6rpx 20rpx rgba(31, 91, 76, .06); }
.stat-item { flex: 1; min-width: 0; margin: 0; padding: 8rpx 0; border-radius: 20rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; background: transparent; line-height: 1.2; transition: background 120ms ease, transform 120ms ease; }
.stat-item--pressed { background: #edf6f2; transform: scale(.96); }
.stat-item__number { color: #174f45; }
.stat-item__number--coral { color: #dc6a5f; }
.stat-item__label { margin-top: 8rpx; color: #4b7066; }
.stat-divider { width: 2rpx; height: 58rpx; background: #e7efec; }
.learning-stats-entry { min-height: 100rpx; padding: 16rpx 20rpx; border-radius: 22rpx; display: flex; align-items: center; background: #e4f3ed; color: #193f36; transition: transform 120ms ease, opacity 120ms ease; }
.learning-stats-entry--pressed { opacity: .82; transform: scale(.985); }
.learning-stats-entry__icon { width: 58rpx; height: 58rpx; flex-shrink: 0; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; background: #fff; color: #21725e; font-size: 32rpx; font-weight: 700; }
.learning-stats-entry__copy { flex: 1; min-width: 0; margin-left: 18rpx; }
.learning-stats-entry__copy text { display: block; }
.learning-stats-entry__copy .type-assistive { margin-top: 4rpx; }
.learning-stats-entry__arrow { color: #5f8178; font-size: 40rpx; font-weight: 300; }
.settings-entry { min-height: 76rpx; padding: 8rpx 18rpx; border-radius: 20rpx; display: flex; align-items: center; color: #4b7066; transition: background 120ms ease, transform 120ms ease; }
.settings-entry--pressed { background: #e9f3ef; transform: scale(.985); }
.settings-entry__icon { width: 42rpx; color: #2c8772; font-size: 34rpx; font-weight: 700; }
.settings-entry .type-body { flex: 1; }
.settings-entry__arrow { color: #91aaa3; font-size: 40rpx; font-weight: 300; }
