.packs-page { min-height: calc(100vh + 240rpx); background: #f4faf7; }
.packs-head { padding: 16rpx 0 28rpx; display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.packs-head__kicker, .packs-head__title, .packs-head__desc { display: block; }
.packs-head__kicker { color: #2c8772; }
.packs-head__title { margin-top: 12rpx; }
.packs-head__desc { max-width: 470rpx; margin-top: 10rpx; }
.create-button { flex-shrink: 0; min-width: 148rpx; height: 72rpx; margin: 8rpx 0 0; padding: 0 20rpx; border-radius: 20rpx; background: #174f45; color: #fff; font-size: 26rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; }
.pack-list { display: flex; flex-direction: column; gap: 18rpx; }
.pack-card { padding: 26rpx; border: 2rpx solid #e7f0ec; border-radius: 28rpx; background: #fff; box-shadow: 0 7rpx 24rpx rgba(31,91,76,.06); transition: transform 120ms ease; }
.pack-card--pressed { transform: scale(.985); }
.pack-card__top { display: flex; align-items: center; }
.pack-card__index { width: 58rpx; height: 58rpx; flex-shrink: 0; border-radius: 18rpx 8rpx 18rpx 8rpx; background: #e6f7f0; color: #21725e; display: flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 700; }
.pack-card__copy { flex: 1; min-width: 0; margin-left: 18rpx; }
.pack-card__name, .pack-card__meta { display: block; overflow-wrap: anywhere; }
.pack-card__name { color: #193f36; font-size: 30rpx; font-weight: 700; line-height: 1.35; }
.pack-card__meta { margin-top: 5rpx; color: #718d85; font-size: 22rpx; }
.pack-card__arrow { color: #91aaa3; font-size: 40rpx; font-weight: 300; }
.pack-card__progress-row { margin-top: 24rpx; color: #4b7066; display: flex; justify-content: space-between; font-size: 22rpx; }
.pack-card__track { height: 10rpx; margin-top: 10rpx; border-radius: 999rpx; background: #edf4f1; overflow: hidden; }
.pack-card__bar { height: 100%; border-radius: inherit; background: #45b38f; }
.pack-card__start { width: 100%; min-height: 72rpx; margin: 22rpx 0 0; padding: 14rpx; border-radius: 18rpx; background: #edf7f3; color: #176b57; font-size: 26rpx; font-weight: 700; line-height: 1.3; }
.empty-packs { min-height: 70vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.empty-packs__illustration { width: 150rpx; height: 116rpx; margin-bottom: 28rpx; position: relative; }
.empty-packs__illustration text { width: 86rpx; height: 96rpx; border-radius: 24rpx; background: #dff3eb; color: #21725e; display: flex; align-items: center; justify-content: center; position: absolute; font-size: 36rpx; font-weight: 700; box-shadow: 0 8rpx 20rpx rgba(31,91,76,.08); }
.empty-packs__illustration text:first-child { left: 0; top: 12rpx; transform: rotate(-7deg); font-family: Georgia, serif; }
.empty-packs__illustration text:last-child { right: 0; top: 0; transform: rotate(6deg); }
.empty-packs__title, .empty-packs__desc { display: block; }
.empty-packs__desc { max-width: 500rpx; margin: 12rpx 0 28rpx; }
